        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph LR\n    %% Actors Definition (Stick Figure Style)\n    Actor_Emp((👤&lt;br&gt;Employee))\n    Actor_Mgr((👥&lt;br&gt;Manager))\n    Actor_HR((⚙️&lt;br&gt;HR / Admin))\n    Actor_Mgmt((📊&lt;br&gt;Management))\n\n    style Actor_Emp fill:#f5f5f5,stroke:#333,stroke-width:2px\n    style Actor_Mgr fill:#f5f5f5,stroke:#333,stroke-width:2px\n    style Actor_HR fill:#f5f5f5,stroke:#333,stroke-width:2px\n    style Actor_Mgmt fill:#f5f5f5,stroke:#333,stroke-width:2px\n\n    %% System Boundary\n    subgraph System_Boundary [Employee Leave Management &amp; Workforce Analytics System]\n        \n        %% Employee Use Cases\n        UC_Login([Login])\n        UC_ViewBal([View Leave Balance])\n        UC_SubReq([Submit Leave Request])\n        UC_ViewStatus([View Leave Status])\n        UC_ViewHist([View Leave History])\n        UC_CancelReq([Cancel Pending Request])\n\n        %% Manager Use Cases\n        UC_ViewPend([View Pending Requests])\n        UC_RevReq([Review Leave Request])\n        UC_AppReq([Approve Leave Request])\n        UC_RejReq([Reject Leave Request])\n        UC_RejReason([Provide Rejection Reason])\n\n        %% HR/Admin Use Cases\n        UC_MgrEmp([Manage Employees])\n        UC_MgrTypes([Manage Leave Types])\n        UC_MgrEnt([Manage Entitlements])\n        UC_MgrRecs([Manage Leave Records])\n        UC_GenRpts([Generate Reports])\n\n        %% Management Use Cases\n        UC_ViewAnlyt([View Leave Analytics])\n        UC_DeptAnlyt([View Department-wise Analysis])\n        UC_MonthTrends([View Monthly Leave Trends])\n        UC_StatAppRej([View Approval/Rejection Statistics])\n\n        %% Relationships inside System\n        UC_RejReq -.-&gt; |include| UC_RejReason\n    end\n\n    style System_Boundary fill:#fdfdfd,stroke:#666,stroke-width:2px,stroke-dasharray: 5 5\n\n    %% Actor Connections\n    %% Employee Connections\n    Actor_Emp --- UC_Login\n    Actor_Emp --- UC_ViewBal\n    Actor_Emp --- UC_SubReq\n    Actor_Emp --- UC_ViewStatus\n    Actor_Emp --- UC_ViewHist\n    Actor_Emp --- UC_CancelReq\n\n    %% Manager Connections\n    Actor_Mgr --- UC_ViewPend\n    Actor_Mgr --- UC_RevReq\n    Actor_Mgr --- UC_AppReq\n    Actor_Mgr --- UC_RejReq\n\n    %% HR/Admin Connections\n    Actor_HR --- UC_MgrEmp\n    Actor_HR --- UC_MgrTypes\n    Actor_HR --- UC_MgrEnt\n    Actor_HR --- UC_MgrRecords\n    Actor_HR --- UC_MgrRecs\n    Actor_HR --- UC_GenRpts\n\n    %% Management Connections\n    Actor_Mgmt --- UC_ViewAnlyt\n    Actor_Mgmt --- UC_DeptAnlyt\n    Actor_Mgmt --- UC_MonthTrends\n    Actor_Mgmt --- UC_StatAppRej\n\n    %% Use Case Styling (Ovals)\n    classDef usecase fill:#e1f5fe,stroke:#03a9f4,stroke-width:1px;\n    class UC_Login,UC_ViewBal,UC_SubReq,UC_ViewStatus,UC_ViewHist,UC_CancelReq,UC_ViewPend,UC_RevReq,UC_AppReq,UC_RejReq,UC_RejReason,UC_MgrEmp,UC_MgrTypes,UC_MgrEnt,UC_MgrRecs,UC_GenRpts,UC_ViewAnlyt,UC_DeptAnlyt,UC_MonthTrends,UC_StatAppRej usecase;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6nHKThUYzTJzu4Hpaw6J-1">
