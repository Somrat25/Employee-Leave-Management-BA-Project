  <diagram name="Page-1" id="z6rCl_xZ7Znajx959m1d">
    <mxGraphModel dx="16530" dy="8410" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TB\n    %% Title Box\n    Title[&lt;b&gt;ELMS — Swimlane Diagram (Proposed To-Be Process)&lt;/b&gt;]\n    style Title fill:#f5f5f5,stroke:#666,stroke-width:2px\n    Title --- Emp_Start\n\n    %% Swimlane 1: Employee\n    subgraph Employee [👤 Employee Lane]\n        Emp_Start([Start: Needs Leave]) --&gt; Emp_Login[Login to System]\n        Emp_View[View Leave Balance]\n        Emp_Submit[Submit Leave Request]\n        Emp_Status[View Request Status] --&gt; Emp_End([End: Request Processed])\n    end\n\n    %% Swimlane 2: ELMS System\n    subgraph ELMS_System [💻 ELMS System Lane]\n        Sys_Auth[Authenticate User]\n        Sys_Disp[Display Leave Balance]\n        Sys_Val{Validate Leave&lt;br&gt;Balance}\n        Sys_Save[Save Leave Request&lt;br&gt;Status = Pending]\n        Sys_NotifMgr[Notify Manager]\n        Sys_UpdateStatus[Update Request Status&lt;br&gt;Approved / Rejected]\n        Sys_UpdateBal[Update Leave Balance]\n        Sys_NotifEmp[Notify Employee]\n    end\n\n    %% Swimlane 3: Manager\n    subgraph Manager [👥 Manager Lane]\n        Mgr_Recv[Receive Notification]\n        Mgr_View[View Pending Request]\n        Mgr_Review[Review Request]\n        Mgr_Decide{Approve or&lt;br&gt;Reject?}\n        Mgr_Reject[Provide Rejection Reason]\n    end\n\n    %% Swimlane 4: HR/Admin\n    subgraph HR_Admin [⚙️ HR / Admin Lane (Administration &amp; Configuration)]\n        HR_M1[Manage Employee Records]\n        HR_M2[Manage Leave Types]\n        HR_M3[Configure Leave Entitlements]\n        HR_M4[View / Manage Leave Records]\n        HR_M5[Generate Reports]\n        \n        %% Flow within HR Lane (Independent Admin Tasks)\n        HR_M1 --&gt; HR_M2 --&gt; HR_M3 --&gt; HR_M4 --&gt; HR_M5\n    end\n\n    %% Cross-Lane Connections (The Actual Process Flow)\n    Emp_Login --&gt; Sys_Auth\n    Sys_Auth --&gt; Emp_View\n    Emp_View --&gt; Sys_Disp\n    Sys_Disp --&gt; Emp_Submit\n    Emp_Submit --&gt; Sys_Val\n    \n    %% Validation Check\n    Sys_Val --&gt;|Valid| Sys_Save\n    Sys_Val --&gt;|Invalid| Emp_Submit\n    \n    Sys_Save --&gt; Sys_NotifMgr\n    Sys_NotifMgr --&gt; Mgr_Recv\n    \n    Mgr_Recv --&gt; Mgr_View\n    Mgr_View --&gt; Mgr_Review\n    Mgr_Review --&gt; Mgr_Decide\n    \n    %% Decision Making\n    Mgr_Decide --&gt;|Approve| Sys_UpdateStatus\n    Mgr_Decide --&gt;|Reject| Mgr_Reject\n    Mgr_Reject --&gt; Sys_UpdateStatus\n    \n    Sys_UpdateStatus --&gt; Sys_UpdateBal\n    Sys_UpdateBal --&gt; Sys_NotifEmp\n    Sys_NotifEmp --&gt; Emp_Status\n\n    %% Styling for Visual Hierarchy\n    style Employee fill:#f9f7ed,stroke:#d6b656,stroke-width:2px\n    style ELMS_System fill:#f2f5fa,stroke:#6c8ebf,stroke-width:2px\n    style Manager fill:#f5fbf7,stroke:#82b366,stroke-width:2px\n    style HR_Admin fill:#fcf3f2,stroke:#b85450,stroke-width:2px\n    \n    classDef process fill:#ffffff,stroke:#333,stroke-width:1px;\n    class Emp_Login,Emp_View,Emp_Submit,Emp_Status,Sys_Auth,Sys_Disp,Sys_Save,Sys_NotifMgr,Sys_UpdateStatus,Sys_UpdateBal,Sys_NotifEmp,Mgr_Recv,Mgr_View,Mgr_Review,Mgr_Reject,HR_M1,HR_M2,HR_M3,HR_M4,HR_M5 process;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="y6G-POBD9E_FDob1BwFW-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
