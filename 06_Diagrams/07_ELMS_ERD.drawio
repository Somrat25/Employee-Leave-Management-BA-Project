        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USER {\n        int User_ID PK\n        string Username\n        string Password_Hash\n        string Role\n        string Status\n    }\n\n    EMPLOYEE {\n        int Employee_ID PK\n        int User_ID FK\n        int Department_ID FK\n        int Manager_ID\n        string Employee_Name\n        string Email\n        date Join_Date\n        string Status\n    }\n\n    DEPARTMENT {\n        int Department_ID PK\n        string Department_Name\n    }\n\n    LEAVE_TYPE {\n        int Leave_Type_ID PK\n        string Leave_Type_Name\n        string Description\n        string Status\n    }\n\n    LEAVE_ENTITLEMENT {\n        int Entitlement_ID PK\n        int Employee_ID FK\n        int Leave_Type_ID FK\n        int Entitlement_Days\n        int Used_Days\n        int Available_Days\n        int Year\n    }\n\n    LEAVE_REQUEST {\n        int Leave_Request_ID PK\n        int Employee_ID FK\n        int Leave_Type_ID FK\n        date Start_Date\n        date End_Date\n        int Requested_Days\n        string Reason\n        string Status\n        datetime Submitted_Date\n    }\n\n    LEAVE_APPROVAL {\n        int Approval_ID PK\n        int Leave_Request_ID FK\n        int Manager_ID FK\n        string Decision\n        datetime Decision_Date\n        string Rejection_Reason\n    }\n\n    NOTIFICATION {\n        int Notification_ID PK\n        int User_ID FK\n        int Leave_Request_ID FK\n        string Notification_Type\n        string Message\n        boolean Is_Read\n        datetime Created_Date\n    }\n\n    %% Relationships Mapping\n    USER ||--|| EMPLOYEE : \&quot;has account\&quot;\n    DEPARTMENT ||--o{ EMPLOYEE : \&quot;contains\&quot;\n    EMPLOYEE ||--o{ LEAVE_REQUEST : \&quot;submits\&quot;\n    LEAVE_TYPE ||--o{ LEAVE_REQUEST : \&quot;categorizes\&quot;\n    EMPLOYEE ||--o{ LEAVE_ENTITLEMENT : \&quot;assigned\&quot;\n    LEAVE_TYPE ||--o{ LEAVE_ENTITLEMENT : \&quot;defines\&quot;\n    LEAVE_REQUEST ||--o{ LEAVE_APPROVAL : \&quot;tracks history\&quot;\n    USER ||--o{ NOTIFICATION : \&quot;receives\&quot;\n    LEAVE_REQUEST ||--o{ NOTIFICATION : \&quot;triggers\&quot;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6Jyffs8fzYJN4nLd3BEP-1">
