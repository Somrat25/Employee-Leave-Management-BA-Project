        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph LR\n    %% Title Box\n    Title[&lt;b&gt;ELMS — Gap Analysis&lt;/b&gt;]\n    style Title fill:#f5f5f5,stroke:#666,stroke-width:2px\n    Title --- CS\n\n    %% Three Main Columns / Subgraphs\n    subgraph CS [CURRENT STATE]\n        C1[1. Email / Paper Form]\n        C2[2. HR Manually Checks &lt;br&gt; Leave Balance]\n        C3[3. HR Calls / Contacts Manager]\n        C4[4. HR Updates Excel / Records]\n        C5[5. Employee Contacts HR &lt;br&gt; for Status]\n        C6[6. Excel-Based Leave Analysis]\n    end\n\n    subgraph G [GAP]\n        G1(Manual Request Submission)\n        G2(Manual Balance Verification)\n        G3(Manual Approval Communication)\n        G4(Manual Record Maintenance)\n        G5(Limited Status Visibility)\n        G6(Limited Reporting &amp; Analytics)\n    end\n\n    subgraph FS [FUTURE STATE]\n        F1[1. Online ELMS Leave Request]\n        F2[2. Automatic Leave Balance Validation]\n        F3[3. System Notification to Manager]\n        F4[4. Automatic Leave Record Update]\n        F5[5. Employee Views Status in ELMS]\n        F6[6. Centralized Reports &amp; &lt;br&gt; Power BI Analytics]\n    end\n\n    %% Connecting Current -&gt; Gap -&gt; Future\n    C1 --&gt; G1 --&gt; F1\n    C2 --&gt; G2 --&gt; F2\n    C3 --&gt; G3 --&gt; F3\n    C4 --&gt; G4 --&gt; F4\n    C5 --&gt; G5 --&gt; F5\n    C6 --&gt; G6 --&gt; F6\n\n    %% Styling Elements for Professional Look\n    style CS fill:#f8cecc,stroke:#b85450,stroke-width:2px\n    style G fill:#fff2cc,stroke:#d6b656,stroke-width:2px\n    style FS fill:#d5e8d4,stroke:#82b366,stroke-width:2px\n    \n    classDef current fill:#ffffff,stroke:#b85450,stroke-width:1px;\n    classDef gap fill:#ffffff,stroke:#d6b656,stroke-width:1px;\n    classDef future fill:#ffffff,stroke:#82b366,stroke-width:1px;\n    \n    class C1,C2,C3,C4,C5,C6 current;\n    class G1,G2,G3,G4,G5,G6 gap;\n    class F1,F2,F3,F4,F5,F6 future;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iX3Y-RsqA4V04lqWxtBY-1">
