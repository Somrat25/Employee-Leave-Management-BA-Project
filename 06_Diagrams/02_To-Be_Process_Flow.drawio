        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Title Box\n    Title[&lt;b&gt;ELMS — To-Be Leave Request Process&lt;/b&gt;]\n    style Title fill:#f5f5f5,stroke:#666,stroke-width:2px\n    Title --- A\n\n    %% Initial Steps\n    A([Employee Needs Leave]) --&gt; B[Employee Logs In]\n    B --&gt; C[Employee Views Leave Balance]\n    C --&gt; D[Employee Submits Leave Request]\n    \n    %% First Decision: Balance Check\n    D --&gt; E{Leave Balance&lt;br&gt;Sufficient?}\n\n    %% NO Branch (Loop back to submit)\n    E --&gt;|No| F[Display Validation Message]\n    F --&gt; G[Employee Revises Request]\n    G --&gt; D\n\n    %% YES Branch\n    E --&gt;|Yes| H[System Saves Leave Request&lt;br&gt;Status: Pending]\n    H --&gt; I[System Notifies Manager]\n    I --&gt; J[Manager Reviews Request]\n    \n    %% Second Decision: Approval\n    J --&gt; K{Approve?}\n\n    %% YES Branch (Approved)\n    K --&gt;|Yes| L[Request Status = Approved]\n    L --&gt; M[System Updates Leave Balance]\n    M --&gt; O\n\n    %% NO Branch (Rejected)\n    K --&gt;|No| N[Manager Provides Rejection Reason]\n    N --&gt; P[Request Status = Rejected]\n    P --&gt; O\n\n    %% Common Ending Flow\n    O[System Notifies Employee] --&gt; Q([Leave Process Completed])\n\n    %% Styling Elements for Better Visuals\n    style A fill:#d5e8d4,stroke:#82b366,stroke-width:2px\n    style Q fill:#f8cecc,stroke:#b85450,stroke-width:2px\n    style E fill:#fff2cc,stroke:#d6b656,stroke-width:2px\n    style K fill:#fff2cc,stroke:#d6b656,stroke-width:2px\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vFg6328o6QbCciXrg4Xk-1">
